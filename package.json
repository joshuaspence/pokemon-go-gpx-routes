{
  "name": "pokemon-go-gpx-routes",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "lint": "npm-run-all --parallel --print-label lint:css lint:format lint:html lint:js lint:xml",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint --fix \"**/*.css\"",
    "lint:fix": "npm-run-all --serial --print-label lint:css:fix lint:js:fix lint:format:fix",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write .",
    "lint:html": "html-validate \"**/*.html\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:xml": "node validate-gpx.mjs"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "html-validate": "11.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-prettier": "5.0.3",
    "xmllint-wasm": "5.3.0"
  }
}
